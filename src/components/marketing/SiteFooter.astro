---
/** Marketing site footer, shared by the landing + standalone pages. */
---

<footer class="footer">
	<div class="footerInner" data-reveal>
		<div class="footerBrand">
			<svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
				<path d="M8 1l6 3.5v7L8 15l-6-3.5v-7L8 1z" fill="none" stroke="#faf9f5" stroke-width="1.4"></path>
				<path d="M8 4.6l3 1.75v3.5L8 11.6 5 9.85v-3.5L8 4.6z" fill="#cc785c"></path>
			</svg>
			<span>PixelForge</span>
		</div>
		<p class="footerNote">
			A local-first photo editor. Runs entirely in your browser — your images never leave
			your device.
		</p>
		<a class="footerCta" href="/editor">Open editor →</a>
	</div>
</footer>

<style>
	.footer {
		background: var(--l-dark);
		padding: 64px 32px;
	}
	.footerInner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.footerBrand {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--l-serif);
		font-size: 20px;
		letter-spacing: -0.3px;
		color: var(--l-on-dark);
	}
	.footerNote {
		margin: 0;
		font-size: 14px;
		line-height: 1.6;
		color: var(--l-on-dark-soft);
		max-width: 44em;
	}
	.footerCta {
		display: inline-flex;
		align-self: flex-start;
		font-size: 14px;
		font-weight: 500;
		color: var(--l-coral);
		transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.3, 1), color 0.2s ease;
	}
	.footerCta:hover {
		transform: translateX(5px);
		color: var(--l-coral-active);
	}
	@media (max-width: 768px) {
		.footer {
			padding: 48px 20px;
		}
	}
</style>
